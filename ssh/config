# Use full hostname unique files for multiplex sockets, to prevent
# connections to github.com-foo and github.com-bar from sharing a
# socket.  That breaks my per-host identity configuration.
Host *
  ControlMaster auto
  ControlPath ~/.ssh/ctrl-%r@%h:%p
  ControlPersist 10m

# Work account
# Repo URLs are: git@github.com-markafoltz:<user>/<repo>
Host github.com-markafoltz
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_github_markafoltz
  IdentitiesOnly Yes

# Personal account
# Repo URLs are: git@github.com-spuddybuddy:<user>/<repo>
Host github.com-spuddybuddy
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_github_spuddybuddy
  IdentitiesOnly Yes

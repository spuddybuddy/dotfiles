# Disable multiplexing for github.com as it breaks identity management.
Host github.com github.com-*
  ControlMaster no

# Work account
# Repo URLs are: git@github.com-markafoltz:<user>/<repo>
Host github.com-markafoltz
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_github_markafoltz
  IdentitiesOnly Yes

# Personal account
# Repo URLs are: git@github.com-spuddybuddy:<user>/<repo>
Host github.com-spuddybuddy
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_github_spuddybuddy
  IdentitiesOnly Yes
